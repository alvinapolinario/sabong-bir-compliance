<%- include('partials/header', { title: 'Tax rules' }) %>
<h1>Tax rules</h1>
<p class="sub">Tax rates are never hard-coded. Each rule names its legal basis and applies to events on or after its effective date. Rules are retired, never edited or deleted. A rate can be a chain of percentages applied in order to the base, e.g. gross bets × 7% × 14% × 1%: enter <code>7 x 14 x 1</code>. Each step is kept exactly; only the final tax is rounded to the centavo.</p>
<% if (error) { %><div class="alert a-bad"><%= error %></div><% } %>

<div class="wrap"><table>
  <thead><tr><th>Tax</th><th>Authority</th><th>Legal basis</th><th>Base</th><th class="n">Rate</th><th>Effective</th><th>Status</th><% if (user.role === 'admin') { %><th></th><% } %></tr></thead>
  <tbody>
  <% rules.forEach(t => { %>
    <tr>
      <td><%= t.name %><% if (formulaText(t)) { %><br><small class="note"><%= formulaText(t) %></small><% } %></td><td><%= t.authority %><%= t.lgu ? ' · ' + t.lgu : '' %></td><td><%= t.legal_basis %></td><td><%= TAX_BASES[t.tax_base] %></td>
      <td class="n"><%= rateText(t) %></td>
      <td><% if (t.effective_to && t.effective_to < t.effective_from) { %>never applied<% } else { %><%= t.effective_from %> → <%= t.effective_to || 'open' %><% } %></td>
      <td><% if (t.retired_at) { %><span class="badge b-muted">retired <%= t.retired_at.slice(0, 10) %></span><% } else { %><span class="badge b-ok">in force</span><% } %></td>
      <% if (user.role === 'admin') { %><td><% if (!t.retired_at) { %>
        <form method="post" action="/tax-rules/<%= t.id %>/retire" class="row"><input type="hidden" name="_csrf" value="<%= csrf %>">
          <label>Last day in force <input type="date" name="last_day" title="Empty = yesterday. The day before the start date = never applied (entered in error)."></label>
          <button class="danger">Retire</button></form>
      <% } %></td><% } %>
    </tr>
  <% }) %>
  <% if (!rules.length) { %><tr><td colspan="8" class="note">No tax rules yet. Add them once the Treasury Office confirms the tax base and rate.</td></tr><% } %>
  </tbody>
</table></div>

<% if (user.role === 'admin') { %>
<h2>Add a rule</h2>
<div class="card">
  <form method="post" action="/tax-rules" class="row">
    <input type="hidden" name="_csrf" value="<%= csrf %>">
    <label>Name <input name="name" required maxlength="120" placeholder="e.g. Amusement tax"></label>
    <label>Authority <select name="authority"><option>LGU</option><option>BIR</option></select></label>
    <label>LGU (if any) <input name="lgu" maxlength="120" placeholder="e.g. City of …"></label>
    <label>Legal basis <input name="legal_basis" required maxlength="200" placeholder="e.g. Ordinance No. …, Sec. …"></label>
    <label>Tax base <select name="tax_base"><% Object.entries(TAX_BASES).forEach(([k, v]) => { %><option value="<%= k %>"><%= v %></option><% }) %></select></label>
    <label>Rate (%) <input name="rate_percent" required maxlength="60" placeholder="e.g. 1   or   7 x 14 x 1" title="One percentage, or several multiplied in order: 7 x 14 x 1"></label>
    <label>Step labels (optional) <input name="rate_labels" maxlength="200" placeholder="e.g. Commission; Operator Safety Net; LGU tax"></label>
    <label>Effective from <input name="effective_from" type="date" required></label>
    <label>Effective to (optional) <input name="effective_to" type="date"></label>
    <button>Add rule</button>
  </form>
</div>
<% } %>
<%- include('partials/footer') %>
