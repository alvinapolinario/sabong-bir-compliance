<%- include('partials/header', { title: 'Sign in' }) %>
<div class="card login">
  <h1>Sign in</h1>
  <p class="sub">Treasury Office and Accounting staff only.</p>
  <% if (error) { %><div class="alert a-bad"><%= error %></div><% } %>
  <form method="post" action="/login" autocomplete="off">
    <input type="hidden" name="_csrf" value="<%= csrf %>">
    <label>Username <input name="username" value="<%= username %>" required maxlength="60" autofocus></label>
    <label>Password <input name="password" type="password" required maxlength="200"></label>
    <button>Sign in</button>
  </form>
</div>
<%- include('partials/footer') %>
