<%- include('partials/header', { title: 'Audit trail' }) %>
<h1>Audit trail</h1>
<% if (chain.ok) { %>
  <div class="alert a-ok">Hash chain intact: all <%= chain.total %> entries verified. No entry has been edited or removed.</div>
<% } else { %>
  <div class="alert a-bad"><strong>Hash chain BROKEN at entry #<%= chain.brokenAt %>.</strong> The audit log was altered outside the application. Report this immediately.</div>
<% } %>
<div class="wrap"><table>
  <thead><tr><th>#</th><th>When</th><th>User</th><th>Action</th><th>Record</th><th>Details</th><th>IP</th></tr></thead>
  <tbody>
  <% rows.forEach(a => { %>
    <tr><td><%= a.id %></td><td><%= a.at %></td><td><%= a.username || 'system' %><div class="note"><%= a.role || '' %></div></td>
      <td><%= a.action.replace(/_/g, ' ') %></td><td><%= a.entity ? a.entity + ' ' + (a.entity_id || '') : '' %></td>
      <td class="note"><%= a.detail ? (typeof a.detail === 'string' ? a.detail : JSON.stringify(a.detail)) : '' %></td><td class="note"><%= a.ip %></td></tr>
  <% }) %>
  </tbody>
</table></div>
<%- include('partials/footer') %>
