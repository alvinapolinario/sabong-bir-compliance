# BIR Compliance System configuration. Copy to .env and fill in.

NODE_ENV=production
PORT=8090
# Only listen locally; nginx is the public entry point.
HOST=127.0.0.1

# Public address (used for secure cookies behind nginx/HTTPS).
APP_URL=https://bir.example.com
ARENA_NAME=Blueknife Gallera

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=bir_compliance
DB_USER=bir_app
DB_PASSWORD=change-me

# Long random string: openssl rand -hex 48
SESSION_SECRET=change-me
SESSION_HOURS=8

# Directory with vps-enc.key / vps-sign.key (chmod 700, never in git).
KEY_PATH=./keys
# Where the original uploaded packages are kept (read-only after write).
PACKAGE_PATH=./storage/packages

# Maximum upload size for one package (MB).
MAX_UPLOAD_MB=20
